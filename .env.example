# Copy this file to .env and fill in your own values.

# Required: SQL Server host and instance name.
DW_SERVER=your-server\your-instance
# Required: database to connect to.
DW_DATABASE=your-database-name

# Optional: ODBC driver name (the value shown is the default).
DW_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Optional: "yes" or "no" (default: no). Use "yes" only in local
# development, when the server has a self-signed certificate.
DW_TRUST_SERVER_CERT=no